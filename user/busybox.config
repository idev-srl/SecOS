# SecOS BusyBox 1.36.1 configuration fragment (hand-written; no menuconfig).
# tools/port-busybox.sh starts from `make allnoconfig`, applies every line of
# this file, then runs `make oldconfig` with default answers so the per-applet
# FEATURE_* sub-options take their upstream defaults. A line of the form
# "# CONFIG_X is not set" forces an option off again after oldconfig.
# SPDX-License-Identifier: MIT (this file); BusyBox itself is GPL-2.0-only.

# --- global build options ---
CONFIG_STATIC=y
CONFIG_LFS=y
CONFIG_LONG_OPTS=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y
CONFIG_FEATURE_COMPRESS_USAGE=y
CONFIG_BUSYBOX=y
CONFIG_FEATURE_HUMAN_READABLE=y
CONFIG_FEATURE_BUFFERS_GO_ON_STACK=y
CONFIG_FEATURE_NON_POSIX_CP=y

# --- applets (priority set requested for SecOS) ---
CONFIG_GREP=y
CONFIG_EGREP=y
CONFIG_FGREP=y
CONFIG_SED=y
CONFIG_AWK=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_CUT=y
CONFIG_TR=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_WC=y
CONFIG_CAT=y
CONFIG_TEE=y
CONFIG_XARGS=y
CONFIG_FIND=y
CONFIG_LS=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_LN=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_TOUCH=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_STAT=y
CONFIG_DU=y
CONFIG_DF=y
CONFIG_FREE=y
CONFIG_PS=y
CONFIG_TOP=y
CONFIG_KILL=y
CONFIG_KILLALL=y
CONFIG_PIDOF=y
CONFIG_UPTIME=y
CONFIG_DATE=y
CONFIG_ENV=y
CONFIG_PRINTENV=y
CONFIG_WHICH=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_READLINK=y
CONFIG_REALPATH=y
CONFIG_SLEEP=y
CONFIG_SEQ=y
CONFIG_YES=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_TEST=y
CONFIG_TEST1=y
CONFIG_TEST2=y
CONFIG_EXPR=y
CONFIG_PRINTF=y
CONFIG_ECHO=y
CONFIG_DIFF=y
CONFIG_CMP=y
CONFIG_MD5SUM=y
CONFIG_SHA1SUM=y
CONFIG_SHA256SUM=y
CONFIG_SHA512SUM=y
CONFIG_OD=y
CONFIG_HEXDUMP=y
CONFIG_STRINGS=y
CONFIG_TAR=y
CONFIG_GZIP=y
CONFIG_GUNZIP=y
CONFIG_ZCAT=y
CONFIG_BZIP2=y
CONFIG_BUNZIP2=y
CONFIG_BZCAT=y
CONFIG_UNXZ=y
CONFIG_XZCAT=y
CONFIG_XZ=y
CONFIG_VI=y
CONFIG_LESS=y
CONFIG_MORE=y
CONFIG_CLEAR=y
CONFIG_RESET=y
CONFIG_HOSTNAME=y
CONFIG_DMESG=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_SYNC=y
CONFIG_WATCH=y
CONFIG_TIME=y
CONFIG_TIMEOUT=y
CONFIG_NL=y
CONFIG_FOLD=y
CONFIG_PASTE=y
CONFIG_SPLIT=y
CONFIG_CAL=y
CONFIG_PING=y
CONFIG_IFCONFIG=y
CONFIG_IP=y
CONFIG_NETSTAT=y
CONFIG_NSLOOKUP=y
CONFIG_WGET=y
CONFIG_TELNET=y
CONFIG_NC=y
# cheap extras that come with the above
CONFIG_TAC=y
CONFIG_REV=y
CONFIG_COMM=y
CONFIG_TRUNCATE=y
CONFIG_PWD=y
CONFIG_UNAME=y
CONFIG_DD=y
CONFIG_SHUF=y
CONFIG_EXPAND=y
CONFIG_UNEXPAND=y
CONFIG_TSORT=y
CONFIG_FACTOR=y
CONFIG_CKSUM=y
CONFIG_CRC32=y
CONFIG_BASE64=y
CONFIG_XXD=y
CONFIG_USLEEP=y
CONFIG_MKTEMP=y
CONFIG_TTY=y
CONFIG_STTY=y
CONFIG_NPROC=y

# --- forced off (no kernel/libc support, or not wanted on SecOS) ---
# CONFIG_FEATURE_IPV6 is not set
# CONFIG_FEATURE_UNIX_LOCAL is not set
# CONFIG_SELINUX is not set
# CONFIG_PAM is not set
# CONFIG_FEATURE_SUID is not set
# CONFIG_FEATURE_UTMP is not set
# CONFIG_FEATURE_WTMP is not set
# CONFIG_FEATURE_PIDFILE is not set
# CONFIG_FEATURE_SYSLOG is not set
# CONFIG_FEATURE_DEVPTS is not set
# CONFIG_FEATURE_SHARED_BUSYBOX is not set
# CONFIG_PIE is not set
# CONFIG_NOMMU is not set
# CONFIG_FEATURE_INSTALLER is not set
# CONFIG_FEATURE_PREFER_APPLETS is not set
# CONFIG_FEATURE_SH_STANDALONE is not set
# CONFIG_UNICODE_SUPPORT is not set
# CONFIG_FEATURE_CLEAN_UP is not set
# CONFIG_FEATURE_USE_SENDFILE is not set
# CONFIG_FEATURE_MOUNT_NFS is not set
# CONFIG_FEATURE_MOUNT_CIFS is not set
# CONFIG_FEATURE_MOUNT_LOOP is not set
# CONFIG_FEATURE_MOUNT_LABEL is not set
# CONFIG_FEATURE_MOUNT_HELPERS is not set
# CONFIG_FEATURE_WGET_HTTPS is not set
# CONFIG_FEATURE_WGET_OPENSSL is not set
# CONFIG_FEATURE_IFCONFIG_SLIP is not set
# CONFIG_FEATURE_NETSTAT_PRG is not set
# CONFIG_FEATURE_TOP_SMP_CPU is not set
# CONFIG_FEATURE_TOP_SMP_PROCESS is not set
# CONFIG_FEATURE_TOPMEM is not set
# CONFIG_FEATURE_SHOW_THREADS is not set
# CONFIG_FEATURE_FIND_CONTEXT is not set
# CONFIG_FEATURE_SEAMLESS_LZMA is not set
# CONFIG_FEATURE_SEAMLESS_Z is not set
# CONFIG_FEATURE_TAR_TO_COMMAND is not set
# CONFIG_FEATURE_VI_USE_SIGNALS is not set
# CONFIG_FEATURE_VI_WIN_RESIZE is not set
# CONFIG_FEATURE_LESS_WINCH is not set
# CONFIG_FEATURE_SYNC_FANCY is not set
# no BusyBox shell: /bin/sh and /bin/bash stay GNU bash
# CONFIG_SHELL_ASH is not set
# CONFIG_SHELL_HUSH is not set
# CONFIG_ASH is not set
# CONFIG_HUSH is not set
# CONFIG_SH_IS_ASH is not set
# CONFIG_SH_IS_HUSH is not set
CONFIG_SH_IS_NONE=y
# CONFIG_FEATURE_EDITING is not set
# hand-written x86 SHA-NI paths and raw clock_gettime syscalls (Linux ABI)
# CONFIG_SHA1_HWACCEL is not set
# CONFIG_SHA256_HWACCEL is not set
# CONFIG_MONOTONIC_SYSCALL is not set
# CONFIG_FEATURE_HWIB is not set
# CONFIG_FEATURE_CP_REFLINK is not set
# nslookup: the small variant (getaddrinfo) instead of the libresolv one
# CONFIG_FEATURE_NSLOOKUP_BIG is not set
# no realtime signals (NSIG is 32 on SecOS)
# CONFIG_FEATURE_RTMINMAX is not set
# Account tools are SecOS's own (login, su, sudo, passwd, useradd, userdel,
# groupadd, usermod, id, whoami, groups: user/ on feat/multiuser-tools), so the
# BusyBox applets of those names (and their siblings that edit /etc/passwd,
# /etc/shadow or /etc/group) stay out: no duplicate /bin entries, one policy.
# CONFIG_ID is not set
# CONFIG_WHOAMI is not set
# CONFIG_GROUPS is not set
# CONFIG_LOGIN is not set
# CONFIG_SU is not set
# CONFIG_SULOGIN is not set
# CONFIG_PASSWD is not set
# CONFIG_CHPASSWD is not set
# CONFIG_CRYPTPW is not set
# CONFIG_MKPASSWD is not set
# CONFIG_ADDUSER is not set
# CONFIG_DELUSER is not set
# CONFIG_ADDGROUP is not set
# CONFIG_DELGROUP is not set
# CONFIG_VLOCK is not set
# CONFIG_GETTY is not set
# BusyBox's own /etc/passwd parser, without shadow support
# CONFIG_FEATURE_SHADOWPASSWDS is not set
# CONFIG_USE_BB_SHADOW is not set
