# /etc/nanorc - system-wide GNU nano settings (SecOS). See nanorc(5).
# Personal settings go in ~/.config/nano/nanorc or ~/.nanorc.

# Show the cursor position in the status bar.
set constantshow
# Keep the indentation of the previous line.
set autoindent
# A tab is 4 columns wide (the file keeps its tab characters).
set tabsize 4
# Do not leave nano's lock files (.name.swp) next to edited files.
unset locking

# Syntax highlighting for the languages installed with nano.
include "/usr/share/nano/*.nanorc"
