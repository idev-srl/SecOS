# Ignore object files
*.o

# Ignore binary files
*.bin

# Ignore log files
*.log

# Ignore image files
*.img
*.iso


# Ignore some directories
build/
dist/
old/
.vscode/

# User program build artifacts (the committed artifact is crypto/user_*_elf.h)
user/*.elf
user/secwm/*.elf
user/lvgl/*.elf
user/*.o
# [crypt] user/libcrypt.a and its objects (rebuilt by `make libcrypt`)
user/*.a
user/cryptobj/
__pycache__/
*.vmdk
uefi_loader.elf
user/*.spkg

# [M34] lua port build artifacts (source in third_party/lua is committed;
# the signed embedded header crypto/user_lua_elf.h is committed)
user/luaobj/
user/lua.elf

# gcc -MMD header dependency files
*.d

# [M40] KEYMAP build stamp
.keymap.stamp
.gui-autostart.stamp
exfat_corrupt/
tools/exfat_fuzz/exfat_fuzz
ntfs_corrupt/
tools/ntfs_fuzz/ntfs_fuzz
*.img.list
.console.stamp
.bkl-default.stamp
