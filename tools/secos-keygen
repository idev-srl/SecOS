#!/usr/bin/env python3
# SecOS code-signing — generate the project Ed25519 keypair and emit the kernel
# public-key header. SPDX-License-Identifier: MIT
#
# Usage:
#   tools/secos-keygen [--seed-hex HEX | --dev] [--out crypto/secos_pubkey.h]
#
# --dev  : derive from the fixed DEV seed (reproducible; NOT for production).
# default: random key; prints the private seed (hex) — store it OFFLINE, never
#          commit it. Only the public key is embedded in the kernel.
import sys, os
from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from secos_signlib import DEV_SEED

def carr(b): return ",".join("0x%02x" % x for x in b)

def main():
    seed = None; out = "crypto/secos_pubkey.h"; dev = False
    args = sys.argv[1:]
    i = 0
    while i < len(args):
        if args[i] == "--dev": dev = True
        elif args[i] == "--seed-hex": i += 1; seed = bytes.fromhex(args[i])
        elif args[i] == "--out": i += 1; out = args[i]
        i += 1
    if dev:
        seed = DEV_SEED
    if seed is None:
        seed = os.urandom(32)
        sys.stderr.write("[keygen] RANDOM private seed (store OFFLINE, do NOT commit):\n  %s\n" % seed.hex())
    sk = Ed25519PrivateKey.from_private_bytes(seed)
    pk = sk.public_key().public_bytes_raw()
    hdr = ("/* SecOS - trusted code-signing public key (Ed25519). Generated by\n"
           " * tools/secos-keygen. The matching private key is NOT in the kernel.\n"
           " * %s key. */\n"
           "#ifndef SECOS_PUBKEY_H\n#define SECOS_PUBKEY_H\n#include <stdint.h>\n"
           "static const uint8_t secos_trusted_pubkey[32] = {%s};\n"
           "#endif\n") % ("DEV (fixed seed)" if dev else "PROJECT", carr(pk))
    open(out, "w").write(hdr)
    sys.stderr.write("[keygen] wrote %s (pubkey %s)\n" % (out, pk.hex()))

if __name__ == "__main__":
    main()
